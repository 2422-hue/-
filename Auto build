end

local function finishBoxToTemplate()
	-- Если коробки нет, но есть выделение — сохраняем выделение
	if not selectionBoxPart then
		if getSelectedCount() == 0 then
			statusLabel.Text = "Коробка не создана"
			return
		end

		local partsList = {}
		local center = Vector3.zero
		local count = 0
		local valid = {}

		for part in pairs(selectedParts) do
			if part and part:IsA("BasePart") and not isIgnoredPart(part) then
				table.insert(valid, part)
				center = center + part.Position
				count = count + 1
			end
		end

		if count == 0 then
			statusLabel.Text = "Нечего сохранять!"
			return
		end

		center = center / count

		for _, part in ipairs(valid) do
			local relativeCFrame = CFrame.new(center):ToObjectSpace(part.CFrame)
			local childrenData = {}
			for _, child in ipairs(part:GetChildren()) do
				table.insert(childrenData, { ClassName = child.ClassName, Name = child.Name })
			end
			table.insert(partsList, {
				Name = part.Name,
				Size = part.Size,
				Color = part.Color,
				Material = part.Material,
				Transparency = part.Transparency,
				RelativeCFrame = relativeCFrame,
				Children = childrenData
			})
		end

		currentTemplate = {
			Parts = partsList,
			Center = center,
			Steps = buildSteps(partsList)
		}
		currentStepIndex = 1
		showingInfo = false
		statusLabel.Text = "Шаблон сохранён! Партов: " .. #partsList
		clearSelection()
		return
	end

	local size = selectionBoxPart.Size
	local cf = selectionBoxPart.CFrame
	local partsInBox = workspace:GetPartBoundsInBox(cf, size)

	local validParts = {}
	local center = Vector3.zero
	local count = 0

	for _, p in ipairs(partsInBox) do
		if p:IsA("BasePart") and not (p == selectionBoxPart) and not isIgnoredPart(p) then
			table.insert(validParts, p)
			center = center + p.Position
			count = count + 1
		end
	end

	if count == 0 then
		statusLabel.Text = "В коробке ничего нет!"
		return
	end

	center = center / count

	local partsList = {}
	for _, part in ipairs(validParts) do
		local relativeCFrame = CFrame.new(center):ToObjectSpace(part.CFrame)

		local childrenData = {}
		for _, child in ipairs(part:GetChildren()) do
			table.insert(childrenData, {
				ClassName = child.ClassName,
				Name = child.Name
			})
		end

		table.insert(partsList, {
			Name = part.Name,
			Size = part.Size,
			Color = part.Color,
			Material = part.Material,
			Transparency = part.Transparency,
			RelativeCFrame = relativeCFrame,
			Children = childrenData
		})
	end

	currentTemplate = {
		Parts = partsList,
		Center = center,
		Steps = buildSteps(partsList)
	}

	currentStepIndex = 1
	showingInfo = false
	statusLabel.Text = "Шаблон сохранён! Партов: " .. #partsList
	destroyBox()
end

-- ====================== СБОРКА (ПОШАГОВАЯ) ======================
local function updateRequirements()
	if showingInfo then return end

	for _, child in ipairs(reqFrame:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	if not currentTemplate or not isBuildingMode then
		reqFrame.Visible = false
		return false, {}
	end

	local steps = currentTemplate.Steps
	if not steps or #steps == 0 then
		reqFrame.Visible = false
		return false, {}
	end

	reqFrame.Visible = true

	if currentStepIndex > #steps then
		statusLabel.Text = "ВСЁ ГОТОВО! Жми ✓"
		btnAssemble.BackgroundColor3 = Color3.fromRGB(40, 200, 80)

		local doneLabel = Instance.new("TextLabel")
		doneLabel.Size = UDim2.new(1, -6, 0, 18)
		doneLabel.BackgroundTransparency = 1
		doneLabel.Text = "Все шаги выполнены!"
		doneLabel.TextColor3 = Color3.fromRGB(70, 255, 110)
		doneLabel.Font = Enum.Font.Gotham
		doneLabel.TextSize = 12
		doneLabel.TextXAlignment = Enum.TextXAlignment.Left
		doneLabel.Parent = reqFrame

		return true, {}
	end

	local step = steps[currentStepIndex]
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return false, {}
	end

	local root = character.HumanoidRootPart
	local foundCount = 0
	local foundParts = {}

	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, SCAN_RADIUS)) do
		if not isIgnoredPart(part) then
			if part.Name == step.Name
				and colorsEqual(part.Color, step.Color)
				and part.Material == step.Material
				and math.abs(part.Transparency - step.Transparency) < 0.01 then
				foundCount = foundCount + 1
				table.insert(foundParts, part)
			end
		end
	end

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -6, 0, 14)
	label.BackgroundTransparency = 1
	label.Text = string.format("Шаг %d/%d: %s", currentStepIndex, #steps, step.Name)
	label.TextColor3 = Color3.fromRGB(200, 200, 255)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = reqFrame

	local info = Instance.new("TextLabel")
	info.Size = UDim2.new(1, -6, 0, 13)
	info.BackgroundTransparency = 1
	info.Text = string.format("%s | RGB(%.0f,%.0f,%.0f)",
		tostring(step.Material):gsub("Enum.Material.", ""),
		step.Color.R * 255, step.Color.G * 255, step.Color.B * 255)
	info.TextColor3 = Color3.fromRGB(220, 220, 220)
	info.Font = Enum.Font.Gotham
	info.TextSize = 10
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.Parent = reqFrame

	local transpInfo = Instance.new("TextLabel")
	transpInfo.Size = UDim2.new(1, -6, 0, 13)
	transpInfo.BackgroundTransparency = 1
	transpInfo.Text = string.format("Прозрачность: %.2f   |   %d / %d", step.Transparency, foundCount, step.Count)
	transpInfo.TextColor3 = foundCount >= step.Count and Color3.fromRGB(70, 255, 110) or Color3.fromRGB(255, 110, 110)
	transpInfo.Font = Enum.Font.Gotham
	transpInfo.TextSize = 10
	transpInfo.TextXAlignment = Enum.TextXAlignment.Left
	transpInfo.Parent = reqFrame

	if foundCount >= step.Count then
		currentStepIndex = currentStepIndex + 1
		statusLabel.Text = "Шаг выполнен! Следующий..."
		btnAssemble.BackgroundColor3 = Color3.fromRGB(200, 80, 30)
		return false, foundParts
	else
		statusLabel.Text = "Собери нужные части рядом"
		btnAssemble.BackgroundColor3 = Color3.fromRGB(200, 80, 30)
		return false, foundParts
	end
end

local function assemble()
	if not currentTemplate then return end

	local steps = currentTemplate.Steps
	if not steps or currentStepIndex <= #steps then
		statusLabel.Text = "Сначала выполни все шаги!"
		return
	end

	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return
	end

	local root = character.HumanoidRootPart
	local buildCF = root.CFrame * CFrame.new(BUILD_OFFSET)

	local available = {}
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, SCAN_RADIUS)) do
		if not isIgnoredPart(part) then
			local key = string.format("%s_%.3f_%.3f_%.3f_%s_%.3f",
				part.Name,
				part.Color.R, part.Color.G, part.Color.B,
				tostring(part.Material),
				part.Transparency)
			if not available[key] then
				available[key] = {}
			end
			table.insert(available[key], part)
		end
	end

	for _, data in ipairs(currentTemplate.Parts) do
		local key = string.format("%s_%.3f_%.3f_%.3f_%s_%.3f",
			data.Name,
			data.Color.R, data.Color.G, data.Color.B,
			tostring(data.Material),
			data.Transparency)
		local list = available[key]
		if list and #list > 0 then
			local part = table.remove(list, 1)
			part.Anchored = true
			part.CanCollide = true
			part.Size = data.Size
			part.Color = data.Color
			part.Material = data.Material
			part.Transparency = data.Transparency
			part.CFrame = buildCF * data.RelativeCFrame
		end
	end

	statusLabel.Text = "Модель собрана точно!"
	isBuildingMode = false
	showingInfo = false
	btnBuild.Text = "Режим сборки"
	btnBuild.BackgroundColor3 = Color3.fromRGB(155, 95, 35)
	reqFrame.Visible = false
	btnAssemble.BackgroundColor3 = Color3.fromRGB(200, 80, 30)
	btnInfo.BackgroundColor3 = Color3.fromRGB(90, 90, 160)
	currentStepIndex = 1
end

