-- ====================== ВСПОМОГАТЕЛЬНЫЕ ======================
local function isIgnoredPart(part)
	if not part or not part:IsA("BasePart") then
		return true
	end

	local name = part.Name
	if name == "Area" or name == "Grid" or name == "RotatePart"
		or name == "Baseplate" or name == "Report" then
		return true
	end

	local char = player.Character
	if char and part:IsDescendantOf(char) then
		return true
	end

	local model = part:FindFirstAncestorOfClass("Model")
	if model and model:FindFirstChildOfClass("Humanoid") then
		return true
	end

	return false
end

local function getSelectedCount()
	local count = 0
	for _ in pairs(selectedParts) do
		count = count + 1
	end
	return count
end

local function clearSelection()
	for part in pairs(selectedParts) do
		if part and part:IsA("BasePart") then
			local hl = part:FindFirstChild("BlueprintHighlight")
			if hl then
				hl:Destroy()
			end
		end
	end
	selectedParts = {}
	statusLabel.Text = "Выделение очищено"
end

local function addToSelection(part)
	if not part:IsA("BasePart") or selectedParts[part] then
		return
	end
	if part == selectionBoxPart or isIgnoredPart(part) then
		return
	end
	selectedParts[part] = true

	local hl = Instance.new("Highlight")
	hl.Name = "BlueprintHighlight"
	hl.FillColor = HIGHLIGHT_COLOR
	hl.OutlineColor = HIGHLIGHT_COLOR
	hl.FillTransparency = 0.65
	hl.Parent = part
end

local function colorsEqual(c1, c2)
	return c1.R == c2.R and c1.G == c2.G and c1.B == c2.B
end

local function buildSteps(partsList)
	local steps = {}
	local lookup = {}

	for _, data in ipairs(partsList) do
		local key = string.format("%s_%.3f_%.3f_%.3f_%s_%.3f",
			data.Name,
			data.Color.R, data.Color.G, data.Color.B,
			tostring(data.Material),
			data.Transparency)

		if not lookup[key] then
			lookup[key] = {
				Name = data.Name,
				Color = data.Color,
				Material = data.Material,
				Transparency = data.Transparency,
				Count = 0
			}
			table.insert(steps, lookup[key])
		end
		lookup[key].Count = lookup[key].Count + 1
	end

	return steps
end

