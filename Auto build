	local root = char and char:FindFirstChild("HumanoidRootPart")
	local spawnCF

	if root then
		spawnCF = root.CFrame * CFrame.new(0, 4, -BOX_DEFAULT_DISTANCE)
	else
		spawnCF = CFrame.new(0, 10, 0)
	end

	selectionBoxPart = Instance.new("Part")
