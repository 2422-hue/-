UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if isBoxMode and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		if mouse.Target == selectionBoxPart then
			isDraggingBox = true
		end
	end

	if input.KeyCode == Enum.KeyCode.B and isBuildingMode then
		assemble()
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDraggingBox and selectionBoxPart and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Delta
		local sens = 0.045
		local move = (camera.CFrame.RightVector * delta.X - camera.CFrame.UpVector * delta.Y) * sens
		selectionBoxPart.CFrame = selectionBoxPart.CFrame + move
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingBox = false
	end
end)

-- ====================== КНОПКИ ======================
btnSelect.MouseButton1Click:Connect(function()
	isSelecting = not isSelecting
	if isSelecting then
		destroyBox()
	end
	btnSelect.BackgroundColor3 = isSelecting and Color3.fromRGB(35, 170, 85) or Color3.fromRGB(55, 115, 200)
	statusLabel.Text = isSelecting and "Режим выделения ВКЛ" or "Режим выделения ВЫКЛ"
end)

btnBox.MouseButton1Click:Connect(function()
	if isBoxMode then
		destroyBox()
		statusLabel.Text = "Коробка выключена"
	else
		isSelecting = false
		btnSelect.BackgroundColor3 = Color3.fromRGB(55, 115, 200)
		createBox()
	end
end)

btnScaleUp.MouseButton1Click:Connect(function()
	if selectionBoxPart then
		selectionBoxPart.Size = selectionBoxPart.Size + Vector3.new(1.5, 1.5, 1.5)
		statusLabel.Text = "Размер: " .. math.floor(selectionBoxPart.Size.X)
	end
end)

btnScaleDown.MouseButton1Click:Connect(function()
	if selectionBoxPart then
		local newSize = selectionBoxPart.Size - Vector3.new(1.5, 1.5, 1.5)
		if newSize.X >= 2 and newSize.Y >= 2 and newSize.Z >= 2 then
			selectionBoxPart.Size = newSize
			statusLabel.Text = "Размер: " .. math.floor(selectionBoxPart.Size.X)
		end
	end
end)

btnDoneBox.MouseButton1Click:Connect(finishBoxToTemplate)
btnInfo.MouseButton1Click:Connect(showTemplateInfo)

btnBuild.MouseButton1Click:Connect(function()
	if not currentTemplate then
		statusLabel.Text = "Сначала сохрани шаблон!"
		return
	end

	-- Если открыта инфа — закрываем её
	if showingInfo then
		showingInfo = false
		for _, child in ipairs(reqFrame:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		btnInfo.BackgroundColor3 = Color3.fromRGB(90, 90, 160)
	end

	isBuildingMode = not isBuildingMode
	currentStepIndex = 1
	btnBuild.BackgroundColor3 = isBuildingMode and Color3.fromRGB(200, 130, 40) or Color3.fromRGB(155, 95, 35)
	btnBuild.Text = isBuildingMode and "Сборка ВКЛ" or "Режим сборки"
	statusLabel.Text = isBuildingMode and "Режим сборки ВКЛ (по шагам)" or "Режим сборки ВЫКЛ"
	if not isBuildingMode then
		reqFrame.Visible = false
	end
end)

btnAssemble.MouseButton1Click:Connect(assemble)

RunService.Heartbeat:Connect(function()
	if isBuildingMode and currentTemplate and not showingInfo then
		updateRequirements()
	end
end)

print("Blueprint Builder (Mobile) загружен")
