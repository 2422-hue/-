local savedObjects = {}

local function addToSave(obj, parent)
    if obj and parent then
        table.insert(savedObjects, { obj = obj, parent = parent })
    end
end

local function hideAllFolders()
    savedObjects = {}

    local bt = workspace:FindFirstChild("BaseThings")
    local map = bt and bt:FindFirstChild("Map_1")
    local baseStuffs = map and map:FindFirstChild("BaseStuffs")
    if baseStuffs then
        for _, obj in ipairs(baseStuffs:GetChildren()) do
            addToSave(obj, baseStuffs)
        end
    end

    local desert = map and map:FindFirstChild("Desert")
    if desert then
        local buildings = desert:FindFirstChild("Buildings")
        if buildings then
            for _, obj in ipairs(buildings:GetChildren()) do
                addToSave(obj, buildings)
            end
        end
    end

    if desert then
        local children = desert:GetChildren()
        local fourth = children[4]
        if fourth then
            addToSave(fourth, desert)
        end
    end

    for _, entry in ipairs(savedObjects) do
        pcall(function() entry.obj.Parent = nil end)
    end
end

local function restoreAllFolders()
    for _, entry in ipairs(savedObjects) do
        pcall(function()
            if entry.obj and entry.obj.Parent == nil then
                entry.obj.Parent = entry.parent
            end
        end)
    end
    savedObjects = {}
end

local function getClosestBathub()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local rootPos = hrp.Position
    local closest = nil
    local minDist = math.huge

    local aiFolder = workspace:FindFirstChild("AI")
    if not aiFolder then return nil end

    for _, obj in ipairs(aiFolder:GetChildren()) do
        if TargetSet[obj.Name] and not isExcluded(obj.Name) then
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
                or obj.PrimaryPart
            if part then
                local dist = (part.Position - rootPos).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = part
                end
            end
        end
    end
    return closest
end

local function teleportAll(targetPos)
    local aiFolder = workspace:FindFirstChild("AI")
    if not aiFolder then return end

    for _, obj in ipairs(aiFolder:GetChildren()) do
        if TargetSet[obj.Name] and not isExcluded(obj.Name) then
            pcall(function()
                if obj:IsA("Model") then
                    obj:PivotTo(CFrame.new(targetPos))
                elseif obj:IsA("BasePart") then
                    obj.CFrame = CFrame.new(targetPos)
                else
                    local part = obj:FindFirstChildWhichIsA("BasePart") or obj.PrimaryPart
                    if part then
                        if obj:IsA("Model") then
                            obj:PivotTo(CFrame.new(targetPos))
                        else
                            part.CFrame = CFrame.new(targetPos)
                        end
                    end
                end
            end)
        end
    end
end

local function removeHumanoids()
    local aiFolder = workspace:FindFirstChild("AI")
    if not aiFolder then return end

    for _, obj in ipairs(aiFolder:GetChildren()) do
        if TargetSet[obj.Name] and not isExcluded(obj.Name) then
            pcall(function()
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum then hum:Destroy() end
            end)
        end
    end
end

local function killAllHumanoids(onlyListed)
    if not onlyListed then
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", 112412400000)
            sethiddenproperty(LocalPlayer, "MaxSimulationRadius", 112412400000)
        end)
    end

    for _, d in pairs(workspace:GetDescendants()) do
        if d.ClassName == "Humanoid"
            and d.Parent.Name ~= LocalPlayer.Name
            and d.Parent.Name ~= "Large Screen"
            and not isExcluded(d.Parent.Name)
            and d.Health ~= 9999
        then
            if onlyListed then
                if TargetSet[d.Parent.Name] then
                    d.Health = 0
                end
            else
                d.Health = 0
            end
        end
    end
end

local function freezeAllNPCs()
    for _, d in pairs(workspace:GetDescendants()) do
        if d.ClassName == "Humanoid"
            and d.Parent.Name ~= LocalPlayer.Name
            and d.Parent.Name ~= "Large Screen"
            and not isExcluded(d.Parent.Name)
            and not TargetSet[d.Parent.Name]
        then
            pcall(function()
                d.WalkSpeed = 0
                d.JumpPower = 0
                d.JumpHeight = 0
                d.AutoRotate = false
                d:Move(Vector3.zero)
            end)
        end
    end
end

local function orbitPlayer()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local elapsed = os.clock() - ORBIT_START_TIME
    local angle = (2 * math.pi) * ORBIT_SPEED_MULT * elapsed

    local x = ORBIT_CENTER.X + math.cos(angle) * ORBIT_RADIUS
    local z = ORBIT_CENTER.Z + math.sin(angle) * ORBIT_RADIUS
    local y = ORBIT_CENTER.Y + ORBIT_HEIGHT

    local pos = Vector3.new(x, y, z)
    hrp.CFrame = CFrame.lookAt(pos, ORBIT_CENTER)
end

local function spamRemotes()
    local closest = getClosestBathub()
    if not closest then return end
    local args = { [1] = closest.Position }

    pcall(function()
        ReplicatedStorage.CharacterRemotes:FindFirstChild("Giant Amplifier").Blast:FireServer(unpack(args))
    end)

    pcall(function()
        ReplicatedStorage.CharacterRemotes.ProtoA1.CoreOrb:FireServer(unpack(args))
    end)
end

local currentMode = 0
local connection = nil
local spamThread = nil

local function stopAll()
    if connection then connection:Disconnect(); connection = nil end
    if spamThread then task.cancel(spamThread); spamThread = nil end
end

local function setActive(btn, active)
    if active then
        btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    else
        btn.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

local function resetButtons()
    setActive(Mode1Btn, false)
    setActive(Mode2Btn, false)
    setActive(Mode3Btn, false)
    setActive(Mode4Btn, false)
end

local function startMode1()
    ORBIT_START_TIME = os.clock()
    hideAllFolders()

    connection = RunService.Heartbeat:Connect(function()
        teleportAll(ORBIT_CENTER)
        removeHumanoids()
        killAllHumanoids(false)
        orbitPlayer()
    end)

    spamThread = task.spawn(function()
        while currentMode == 1 do
            spamRemotes()
            task.wait(0.5)
        end
    end)
end

local function startMode2()
