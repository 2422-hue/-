end

local function startMode4()
    connection = RunService.Heartbeat:Connect(function()
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", 112412400000)
            sethiddenproperty(LocalPlayer, "MaxSimulationRadius", 112412400000)
        end)

        for _, d in pairs(workspace:GetDescendants()) do
            if d.ClassName == "Humanoid"
                and d.Parent.Name ~= LocalPlayer.Name
                and d.Health ~= 9999
                and not TargetSet[d.Parent.Name]
            then
                d.Health = 0
            end
        end
    end)
end

